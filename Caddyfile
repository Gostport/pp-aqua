# Домен и почта приезжают из .env через docker-compose.
{
	email {$AQUA_EMAIL}
}

{$AQUA_DOMAIN} {
	# Сервер отдаёт три.js и модели как есть — сжатие заметно ускоряет
	# первую загрузку сцены.
	encode zstd gzip

	# Картинки рыбок и снимки сцен ходят большими телами.
	request_body {
		max_size 16MB
	}

	reverse_proxy aqua:8000

	# Журнала обращений нет намеренно: в нём лежали бы IP-адреса тех, кто
	# смотрит детские рисунки, а нужды в них никакой. Служебные сообщения
	# самого сервера (какая рыбка добавлена, в какой аквариум) пишутся
	# в docker logs и адресов не содержат.
}
