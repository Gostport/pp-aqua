# Скопировать в .env и поправить под себя.

# Домен аквариума: по нему Traefik строит роутер и берёт сертификат.
DOMAIN=aquarium.mrmot9i.com

# Демо-аквариум: код аквариума-витрины, кнопка «Посмотреть живой аквариум»
# на главной для тех, у кого своего ещё нет. Не задан — кнопки нет.
# AQUA_DEMO_TANK=

# Пределы (можно не трогать)
# AQUA_MAX_TANKS=200
# AQUA_TANKS_PER_HOUR=5
# AQUA_MAX_FISH=40
# AQUA_MAX_BG=8
# AQUA_MAX_DATA_MB=2048
